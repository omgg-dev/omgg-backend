    },
    "name": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "attestants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::attestant.attestant",
      "mappedBy": "company"
    },
    "quotations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quotation.quotation",
      "mappedBy": "company"
    }
  }
